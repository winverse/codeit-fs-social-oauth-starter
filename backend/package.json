{
  "name": "codeit-fs-social-oauth-backend",
  "version": "1.0.0",
  "description": "",
  "main": "./src/main.js",
  "type": "module",
  "imports": {
    "#config": "./src/config/config.js",
    "#prisma/*": "./src/prisma/*",
    "#docs/*": "./src/docs/*",
    "#repository": "./src/repository/index.js",
    "#constants": "./src/common/constants/index.js",
    "#exceptions": "./src/common/exceptions/index.js",
    "#controllers": "./src/controllers/index.js",
    "#controllers/*": "./src/controllers/*",
    "#services": "./src/services/index.js",
    "#middlewares": "./src/middlewares/index.js",
    "#providers": "./src/providers/index.js"
  },
  "scripts": {
    "dev": "nodemon --env-file=./env/.env.development ./src/main.js",
    "prod": "node --env-file=./env/.env.production src/main.js",
    "contract:emit": "dotenv -e ./env/.env.development -- prisma contract emit --config prisma.config.js --format human",
    "db:init": "dotenv -e ./env/.env.development -- prisma db init --config prisma.config.js --format human",
    "db:update": "dotenv -e ./env/.env.development -- prisma db update --config prisma.config.js --format human",
    "seed": "node --env-file=./env/.env.development ./scripts/seed.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "node --test",
    "check": "pnpm format:check && pnpm lint && pnpm test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "dependencies": {
    "@prisma/orm-postgres": "8.0.0-rc.11",
    "awilix": "^13.0.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.1.0",
    "dotenv-cli": "^11.0.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.2.1",
    "zod-openapi": "^5.4.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@faker-js/faker": "^10.1.0",
    "eslint": "^9.39.2",
    "nodemon": "^3.1.11",
    "prettier": "^3.7.4",
    "prisma": "8.0.0-rc.15"
  }
}
