# 이 파일을 env/.env.development로 복사한 뒤 로컬 값으로 교체합니다.
# 실제 secret 파일은 Git에 추가하지 않습니다.

NODE_ENV=development
PORT=5001
DATABASE_URL=postgresql://<database-user>:<database-password>@localhost:5432/social_oauth

JWT_ACCESS_SECRET=replace-with-a-secure-random-string-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-secure-random-string-at-least-32-characters
OAUTH_STATE_SECRET=replace-with-another-secure-random-string-at-least-32-characters

CORS_ORIGINS=http://localhost:3000
API_BASE_URL=http://localhost:5001
CLIENT_BASE_URL=http://localhost:3000

GOOGLE_CLIENT_ID=replace-with-your-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-client-secret
KAKAO_CLIENT_ID=replace-with-your-kakao-rest-api-key
KAKAO_CLIENT_SECRET=replace-with-your-kakao-client-secret
NAVER_CLIENT_ID=replace-with-your-naver-client-id
NAVER_CLIENT_SECRET=replace-with-your-naver-client-secret
